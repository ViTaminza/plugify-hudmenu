{
  // hudmenu gamedata - s2sdk gamedata format (same schema as the s2sdk plugin's own
  // gamedata.jsonc), loaded via s2sdk LoadGameConfigFile / GetGameConfigSignature.
  //
  // Signatures: the CCSCustomHudLayout cs_script API (the Panorama on-screen menu entity
  // spawned as "custom_hud_layout"). Patterns are the linux ones cs2-menus ships in
  // addons/configs/signatures.ini (keys are the same CCSCustomHudLayout_* override names),
  // cross-checked against SwiftlyS2's gamedata/cs2/core/signatures.jsonc for the same
  // game build. win64 patterns come from SwiftlyS2.
  //
  // Game ABI (from libserver.so disassembly, see ref/pisex/SchemaEntity/CCSCustomHudLayout.h):
  //   SetHasClassForPlayer(this, int slot, const CUtlString& panelId, const CUtlString& className, int status)
  //   SetHasClass(this, const CUtlString& panelId, const CUtlString& className, int status)
  //   SetDialogVariableStringForPlayer(this, int slot, const CUtlString& panelId, const CUtlString& name, const CUtlString& value)
  //   SetDialogVariableString(this, const CUtlString& panelId, const CUtlString& name, const CUtlString& value)
  //   SetInputCaptureEnabled(this, int slot, bool)
  // EHudPanelClassStatus_t: HasClass = 1, DoesNotHaveClass = 0. Per-player calls are no-ops
  // for slots with no player state (slot >= m_vecPlayerLayoutStates.Count()).
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify-plugin-s2sdk/refs/heads/main/schemas/gamedata.schema.json",
  "csgo": {
    "Signatures": {
      "CCSCustomHudLayout_SetHasClass": {
        "library": "server",
        "win64": "48 89 5C 24 ? 48 89 6C 24 ? 48 89 74 24 ? 57 48 83 EC ? 49 8B F0 33 ED 4C 8D 44 24 ? 66 89 6C 24 ? 41 8B F9",
        "linuxsteamrt64": "55 48 89 E5 41 57 49 89 D7 41 56 48 8D 55"
      },
      "CCSCustomHudLayout_SetHasClassForPlayer": {
        "library": "server",
        "win64": "85 D2 0F 88 ? ? ? ? 53 55 56 48 83 EC ? 48 63 DA 49 8B E9 49 8B C0 48 8B F1 48 89 7C 24 ? 3B 99 ? ? ? ? 0F 8D ? ? ? ? 4C 89 74 24 ? 4C 8D 44 24 ? 45 33 F6 48 8B D0 66 44 89 74 24 ? E8 ? ? ? ? 84 C0 74 ? 4C 8D 44 24 ? 66 44 89 74 24 ? 48 8B D5 48 8B CE E8 ? ? ? ? 84 C0 74 ? 0F B6 86 ? ? ? ? A8 ? 74 ? A8 ? 75 ? 4C 8D 44 24 ? 48 C7 44 24 ? ? ? ? ? B2 ? 48 8D 8E ? ? ? ? E8 ? ? ? ? 44 8B 4C 24",
        "linuxsteamrt64": "55 48 89 E5 41 56 41 55 41 54 53 89 F3 48 83 EC ? 85 F6 78 ? 49 89 FD 39 B7 ? ? ? ? 7F ? 48 83 C4 ? 5B 41 5C 41 5D 41 5E 5D C3 ? ? ? 48 89 D6 31 D2 49 89 CE 66 89 55 ? 48 8D 55 ? 45 89 C4"
      },
      "CCSCustomHudLayout_SetDialogVariableString": {
        "library": "server",
        "win64": "48 89 5C 24 ? 48 89 6C 24 ? 48 89 74 24 ? 57 48 83 EC ? 49 8B F0 33 ED 4C 8D 44 24 ? 66 89 6C 24 ? 49 8B F9",
        "linuxsteamrt64": "55 48 89 E5 41 55 49 89 CD 41 54 49 89 D4 31 D2"
      },
      "CCSCustomHudLayout_SetDialogVariableStringForPlayer": {
        "library": "server",
        "win64": "85 D2 0F 88 ? ? ? ? 53 55 56 48 83 EC ? 48 63 DA 49 8B E9 49 8B C0 48 8B F1 48 89 7C 24 ? 3B 99 ? ? ? ? 0F 8D ? ? ? ? 4C 89 74 24 ? 4C 8D 44 24 ? 45 33 F6 48 8B D0 66 44 89 74 24 ? E8 ? ? ? ? 84 C0 74 ? 4C 8D 44 24 ? 66 44 89 74 24 ? 48 8B D5 48 8B CE E8 ? ? ? ? 84 C0 74 ? 0F B6 86 ? ? ? ? A8 ? 74 ? A8 ? 75 ? 4C 8D 44 24 ? 48 C7 44 24 ? ? ? ? ? B2 ? 48 8D 8E ? ? ? ? E8 ? ? ? ? 4C 8B 4C 24",
        "linuxsteamrt64": "55 48 89 E5 41 56 41 55 41 54 53 89 F3 48 83 EC ? 85 F6 78 ? 49 89 FD 39 B7 ? ? ? ? 7F ? 48 83 C4 ? 5B 41 5C 41 5D 41 5E 5D C3 ? ? ? 48 89 D6 31 D2 49 89 CE 66 89 55 ? 48 8D 55 ? 4D 89 C4"
      },
      "CCSCustomHudLayout_SetInputCaptureEnabled": {
        "library": "server",
        "win64": "85 D2 78 ? 48 89 5C 24 ? 56",
        "linuxsteamrt64": "55 48 89 E5 41 55 41 54 53 48 63 DE 48 83 EC"
      }
    },
    "Offsets": {
      // ISource2GameClients::ClientSvcUserMessage vtable index (polyhook override).
      //
      // Counting rule (a miscount here crashed the live server once): the vtable starts with the
      // BASE class virtuals. In the CS2 build we target IAppSystem contributes 11 of them
      // (Connect, Disconnect, QueryInterface, Init, Shutdown, ...), then ISource2GameClients adds
      // its own: ClientSvcUserMessage is the 28th of them (OnClientConnected ... unk101 are the
      // 27 before it, counted in ref/hl2sdk/eiface.h). 11 + 27 = 38, 0-based.
      //
      // Re-count both parts against ref/hl2sdk/eiface.h after a game update (a game update that
      // inserts a virtual into either interface shifts this index; the disassembly of
      // libserver.so is the ground truth - see the note in src/click_hook.cpp).
      "ClientSvcUserMessageVTableIndex": {
        "win64": 38,
        "linuxsteamrt64": 38
      }
    }
  }
}
